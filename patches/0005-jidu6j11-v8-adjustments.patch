++		DECLARE_FLEX_ARRAY(struct mwifiex_ds_param_set, ds_param_set);
+ 	} fh_ds;
+ } __packed;
+ 
+@@ -1383,7 +1383,7 @@ struct host_cmd_ds_802_11_snmp_mib {
+ 	__le16 query_type;
