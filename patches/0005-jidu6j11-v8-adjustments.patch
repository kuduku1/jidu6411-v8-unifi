diff --git a/package/firmware/jidu6j11-board-data/Makefile b/package/firmware/jidu6j11-board-data/Makefile
new file mode 100644
index 00000000..034596f0
--- /dev/null
+++ b/package/firmware/jidu6j11-board-data/Makefile
@@ -0,0 +1,32 @@
+include $(TOPDIR)/rules.mk
+
+PKG_NAME:=jidu6j11-board-data
+PKG_RELEASE:=1
+PKG_FLAGS:=nonshared
+
+include $(INCLUDE_DIR)/package.mk
+
+define Package/jidu6j11-board-data
+  SECTION:=firmware
+  CATEGORY:=Firmware
+  TITLE:=ath11k board-2.bin for JioRouter AX6000 JIDU6J11 (all SKUs)
+  DEPENDS:=@TARGET_qualcommbe
+endef
+
+define Package/jidu6j11-board-data/description
+  board-2.bin for the IPQ9574 (2.4 GHz) and QCN9074 (5 GHz) radios of the
+  JIDU6J11 series, with variants JIDU6J11-6111/6411/6611/6811/6911.
+  Taken from the working JIDU6J11 image built 2026-09-27, until the board
+  data is merged into qca-wireless upstream.
+endef
+
+define Build/Compile
+endef
+
+define Package/jidu6j11-board-data/install
+	$(INSTALL_DIR) $(1)/lib/firmware/ath11k/IPQ9574/hw1.0 $(1)/lib/firmware/ath11k/QCN9074/hw1.0
+	$(INSTALL_DATA) ./files/board-2.IPQ9574.bin $(1)/lib/firmware/ath11k/IPQ9574/hw1.0/board-2.bin
+	$(INSTALL_DATA) ./files/board-2.QCN9074.bin $(1)/lib/firmware/ath11k/QCN9074/hw1.0/board-2.bin
+endef
+
+$(eval $(call BuildPackage,jidu6j11-board-data))
