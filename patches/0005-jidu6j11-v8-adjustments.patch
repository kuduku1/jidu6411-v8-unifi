diff --git a/package/kernel/mac80211/patches/subsys/402-wifi-mac80211_hwsim-reserve-headroom-for-software-encryp.patch b/package/kernel/mac80211/patches/subsys/402-wifi-mac80211_hwsim-reserve-headroom-for-software-encryp.patch
