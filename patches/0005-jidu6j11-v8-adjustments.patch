--- a/package/kernel/mac80211/patches/subsys/421-wifi-mac80211-report-the-totals-of-an-MLO-station-when-it-is-removed.patch
+++ /dev/null
@@ -1,72 +0,0 @@
-From: Felix Fietkau <nbd@nbd.name>
-Date: Thu, 1 Oct 2026 22:30:28 +0200
-Subject: [PATCH] wifi: mac80211: report the totals of an MLO station when it
- is removed
-
-The removal notification of a station carries its closing counters, and
-userspace that keeps totals across a station's departure takes them
-from there. For an MLO station they were the counters of the default
-link alone: mac80211 filled the station info without links, so
-sta_set_sinfo() dropped every link, and cfg80211_del_sta_sinfo() sent
-it without the MLD aggregation that NL80211_CMD_GET_STATION applies.
-The received counters of the other links and the counters of removed
-links were missing.
-
-Fill the station info of a removed station as ieee80211_get_station()
-does: allocate its links, then add the counters of removed links. Apply
-cfg80211_sta_set_mld_sinfo() before the notification is sent. As in
-NL80211_CMD_GET_STATION, a link whose interface link is already gone,
-which is the case when the interface removes the link and flushes its
-stations, or whose link info could not be allocated, is not counted.
-
-Signed-off-by: Felix Fietkau <nbd@nbd.name>
----
- net/mac80211/sta_info.c | 20 +++++++++++++++++++-
- net/wireless/nl80211.c  |  3 +++
- 2 files changed, 22 insertions(+), 1 deletion(-)
-
---- a/net/mac80211/sta_info.c
-+++ b/net/mac80211/sta_info.c
-@@ -1572,6 +1572,21 @@ int sta_info_move_state(struct sta_info
- 	return _sta_info_move_state(sta, new_state, true);
- }
- 
-+static void sta_set_removal_sinfo(struct sta_info *sta,
-+				  struct station_info *sinfo)
-+{
-+	int link_id;
-+
-+	for (link_id = 0; link_id < IEEE80211_MLD_MAX_NUM_LINKS; link_id++)
-+		if (sta->sta.valid_links & BIT(link_id))
-+			sinfo->links[link_id] = kzalloc_obj(*sinfo->links[0]);
-+
-+	sta_set_sinfo(sta, sinfo, true);
-+
-+	if (sinfo->valid_links)
-+		sta_set_accumulated_removed_links_sinfo(sta, sinfo);
-+}
-+
- static void __sta_info_destroy_part2(struct sta_info *sta, bool recalc)
- {
- 	struct ieee80211_local *local = sta->local;
-@@ -1627,7 +1642,7 @@ static void __sta_info_destroy_part2(str
- 
- 	sinfo = kzalloc_obj(*sinfo);
- 	if (sinfo)
--		sta_set_sinfo(sta, sinfo, true);
-+		sta_set_removal_sinfo(sta, sinfo);
- 
- 	if (sta->uploaded) {
- 		ret = drv_sta_state(local, sdata, sta, IEEE80211_STA_NONE,
---- a/net/wireless/nl80211.c
-+++ b/net/wireless/nl80211.c
-@@ -21839,6 +21839,9 @@ void cfg80211_del_sta_sinfo(struct wirel
- 		return;
- 	}
- 
-+	if (sinfo->valid_links)
-+		cfg80211_sta_set_mld_sinfo(sinfo);
-+
- 	if (nl80211_send_station(msg, NL80211_CMD_DEL_STATION, 0, 0, 0,
- 				 rdev, wdev, mac_addr, sinfo) < 0) {
- 		nlmsg_free(msg);
diff --git a/package/kernel/mac80211/patches/subsys/422-wifi-mac80211-resolve-the-RX-link-of-each-station-on-its-own.patch b/package/kernel/mac80211/patches/subsys/422-wifi-mac80211-resolve-the-RX-link-of-each-station-on-its-own.patch
deleted file mode 100644
index d4645a98..00000000
--- a/package/kernel/mac80211/patches/subsys/422-wifi-mac80211-resolve-the-RX-link-of-each-station-on-its-own.patch
+++ /dev/null
@@ -1,157 +0,0 @@
-From: Felix Fietkau <nbd@nbd.name>
-Date: Thu, 8 Oct 2026 12:30:00 +0200
-Subject: [PATCH] wifi: mac80211: resolve the RX link of each station on its
- own
-
-When several stations match addr2 of a data frame, the loop in
-__ieee80211_rx_handle_packet() delivers the frame to each of them and
-resolves the link of an MLO station with link_sta_info_get_bss(). Two
-things go wrong there:
-
-- If the lookup fails, the loop continues without moving prev_sta to
-  the current station. Each later pass retries the same station, so no
-  station after it gets the frame.
-- The resolved link_id is kept for the stations that follow. A later
-  non-MLO station then gets a link_id that is not in its valid_links,
-  ieee80211_rx_data_set_link() fails and the frame is dropped.
-
-Resolve the link for each station on its own and skip only the station
-whose link lookup fails. Use the same code for the station that the
-driver passes, which resolves its link the same way.
-
-Signed-off-by: Felix Fietkau <nbd@nbd.name>
----
---- a/net/mac80211/rx.c
-+++ b/net/mac80211/rx.c
-@@ -5373,6 +5373,37 @@ static bool ieee80211_rx_for_link_sta(st
- 	return ieee80211_prepare_and_rx_handle(rx, skb, consume);
- }
- 
-+static bool ieee80211_rx_for_sta(struct ieee80211_rx_data *rx,
-+				 struct sta_info *sta, struct sk_buff *skb,
-+				 bool consume)
-+{
-+	struct ieee80211_rx_status *status = IEEE80211_SKB_RXCB(skb);
-+	struct ieee80211_hdr *hdr = (void *)skb->data;
-+	int link_id = -1;
-+
-+	/*
-+	 * When the driver or hardware already translated the addresses, it
-+	 * must pass the link_id in the status.
-+	 */
-+	rx->sdata = sta->sdata;
-+	if (status->link_valid) {
-+		link_id = status->link_id;
-+	} else if (sta->sta.mlo) {
-+		struct link_sta_info *link_sta;
-+
-+		link_sta = link_sta_info_get_bss(rx->sdata, hdr->addr2);
-+		if (!link_sta)
-+			return false;
-+
-+		link_id = link_sta->link_id;
-+	}
-+
-+	if (!ieee80211_rx_data_set_sta(rx, sta, link_id))
-+		return false;
-+
-+	return ieee80211_prepare_and_rx_handle(rx, skb, consume);
-+}
-+
- /*
-  * This is the actual Rx frames handler. as it belongs to Rx path it must
-  * be called with rcu_read_lock protection.
-@@ -5383,7 +5414,6 @@ static void __ieee80211_rx_handle_packet
- 					 struct list_head *list)
- {
- 	struct ieee80211_local *local = hw_to_local(hw);
--	struct ieee80211_rx_status *status = IEEE80211_SKB_RXCB(skb);
- 	struct ieee80211_sub_if_data *sdata;
- 	struct ieee80211_hdr *hdr;
- 	__le16 fc;
-@@ -5440,38 +5470,10 @@ static void __ieee80211_rx_handle_packet
- 	if (ieee80211_is_data(fc)) {
- 		struct link_sta_info *link_sta, *prev_link_sta;
- 		struct sta_info *sta, *prev_sta;
--		int link_id = -1;
--
--		if (status->link_valid)
--			link_id = status->link_id;
- 
- 		if (pubsta) {
- 			sta = container_of(pubsta, struct sta_info, sta);
--			if (!ieee80211_rx_data_set_sta(&rx, sta, link_id))
--				goto out;
--
--			/*
--			 * In MLO connection, fetch the link_id using addr2
--			 * when the driver does not pass link_id in status.
--			 * When the address translation is already performed by
--			 * driver/hw, the valid link_id must be passed in
--			 * status.
--			 */
--
--			if (!status->link_valid && pubsta->mlo) {
--				struct link_sta_info *link_sta;
--
--				link_sta = link_sta_info_get_bss(rx.sdata,
--								 hdr->addr2);
--				if (!link_sta)
--					goto out;
--
--				if (!ieee80211_rx_data_set_link(&rx,
--								link_sta->link_id))
--					goto out;
--			}
--
--			if (ieee80211_prepare_and_rx_handle(&rx, skb, true))
-+			if (ieee80211_rx_for_sta(&rx, sta, skb, true))
- 				return;
- 			goto out;
- 		}
-@@ -5484,43 +5486,13 @@ static void __ieee80211_rx_handle_packet
- 				continue;
- 			}
- 
--			rx.sdata = prev_sta->sdata;
--			if (!status->link_valid && prev_sta->sta.mlo) {
--				struct link_sta_info *link_sta;
--
--				link_sta = link_sta_info_get_bss(rx.sdata,
--								 hdr->addr2);
--				if (!link_sta)
--					continue;
--
--				link_id = link_sta->link_id;
--			}
--
--			if (!ieee80211_rx_data_set_sta(&rx, prev_sta, link_id))
--				goto out;
--
--			ieee80211_prepare_and_rx_handle(&rx, skb, false);
-+			ieee80211_rx_for_sta(&rx, prev_sta, skb, false);
- 
- 			prev_sta = sta;
- 		}
- 
- 		if (prev_sta) {
--			rx.sdata = prev_sta->sdata;
--			if (!status->link_valid && prev_sta->sta.mlo) {
--				struct link_sta_info *link_sta;
--
--				link_sta = link_sta_info_get_bss(rx.sdata,
--								 hdr->addr2);
--				if (!link_sta)
--					goto out;
--
--				link_id = link_sta->link_id;
--			}
--
--			if (!ieee80211_rx_data_set_sta(&rx, prev_sta, link_id))
--				goto out;
--
--			if (ieee80211_prepare_and_rx_handle(&rx, skb, true))
-+			if (ieee80211_rx_for_sta(&rx, prev_sta, skb, true))
- 				return;
- 			goto out;
- 		}
