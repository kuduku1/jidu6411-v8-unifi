diff --git a/package/kernel/mac80211/patches/subsys/394-wifi-mac80211-select-the-link-a-management-frame-asks.patch b/package/kernel/mac80211/patches/subsys/394-wifi-mac80211-select-the-link-a-management-frame-asks.patch
