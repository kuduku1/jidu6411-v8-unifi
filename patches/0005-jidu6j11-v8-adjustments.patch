- 
-+/*
-+ * ieee80211_prepare_and_rx_handle() translates the addresses of
-+ * individually addressed frames only.
-+ */
-+static void ieee80211_mgd_group_addrs_to_mld(struct ieee80211_link_data *link,
-+					     struct ieee80211_mgmt *mgmt)
-+{
-+	struct ieee80211_sub_if_data *sdata = link->sdata;
-+
-+	if (!ieee80211_vif_is_mld(&sdata->vif) ||
-+	    !is_multicast_ether_addr(mgmt->da))
-+		return;
-+
-+	if (!ether_addr_equal(mgmt->bssid, link->u.mgd.bssid) ||
-+	    !ether_addr_equal(mgmt->sa, link->u.mgd.bssid))
-+		return;
-+
-+	ether_addr_copy(mgmt->sa, sdata->vif.cfg.ap_addr);
-+	ether_addr_copy(mgmt->bssid, sdata->vif.cfg.ap_addr);
-+}
-+
- static void ieee80211_rx_mgmt_deauth(struct ieee80211_sub_if_data *sdata,
- 				     struct ieee80211_mgmt *mgmt, size_t len)
- {
-@@ -11845,9 +11866,11 @@ void ieee80211_sta_rx_queued_frame(struc
- 		ieee80211_rx_mgmt_auth(sdata, mgmt, skb->len);
- 		break;
- 	case IEEE80211_STYPE_DEAUTH:
-+		ieee80211_mgd_group_addrs_to_mld(link, mgmt);
- 		ieee80211_rx_mgmt_deauth(sdata, mgmt, skb->len);
- 		break;
- 	case IEEE80211_STYPE_DISASSOC:
-+		ieee80211_mgd_group_addrs_to_mld(link, mgmt);
- 		ieee80211_rx_mgmt_disassoc(sdata, mgmt, skb->len);
- 		break;
- 	case IEEE80211_STYPE_ASSOC_RESP:
diff --git a/package/kernel/mac80211/patches/subsys/410-wifi-cfg80211-keep-the-interface-state-while-another-AP-link-beacons.patch b/package/kernel/mac80211/patches/subsys/410-wifi-cfg80211-keep-the-interface-state-while-another-AP-link-beacons.patch
deleted file mode 100644
index 9f78b20b..00000000
--- a/package/kernel/mac80211/patches/subsys/410-wifi-cfg80211-keep-the-interface-state-while-another-AP-link-beacons.patch
+++ /dev/null
@@ -1,50 +0,0 @@
-From ce8ef1122015eea58c300485a330320985a27a19 Mon Sep 17 00:00:00 2001
-From: Felix Fietkau <nbd@nbd.name>
-Date: Tue, 29 Sep 2026 07:41:25 +0200
-Subject: [PATCH] wifi: cfg80211: keep the interface state while another AP
- link beacons
-
-Since stop_ap works per link, ___cfg80211_stop_ap() stops one link of
-an AP MLD, but clears state that belongs to the interface: the
-connection owner, the SSID and the QoS map. The other links keep
-beaconing with an empty SSID in NL80211_CMD_GET_INTERFACE and no DSCP
-to user priority map, until the next START_AP on some link sets them
-again.
-
-Clear them only when no link of the interface beacons any more.
-
-This changes what userspace sees. nl80211_start_ap() refuses, with
--EINVAL, a link whose SSID differs from the one the interface holds
-("require identical SSID for MLO"). With the SSID kept, a START_AP that
-changes the SSID of one link while another link beacons with the old
-one now fails, where it succeeded before. Userspace has to stop all
-links of the interface before it starts them with a new SSID, which is
-what an SSID shared by an AP MLD needs.
-
-Fixes: 7b0a0e3c3a88 ("wifi: cfg80211: do some rework towards MLO link APIs")
-Signed-off-by: Felix Fietkau <nbd@nbd.name>
----
- net/wireless/ap.c | 11 ++++++++---
- 1 file changed, 8 insertions(+), 3 deletions(-)
-
---- a/net/wireless/ap.c
-+++ b/net/wireless/ap.c
-@@ -35,12 +35,15 @@ static int ___cfg80211_stop_ap(struct cf
- 
- 	err = rdev_stop_ap(rdev, dev, link_id);
- 	if (!err) {
--		wdev->conn_owner_nlportid = 0;
- 		wdev->links[link_id].ap.beacon_interval = 0;
- 		memset(&wdev->links[link_id].ap.chandef, 0,
- 		       sizeof(wdev->links[link_id].ap.chandef));
--		wdev->u.ap.ssid_len = 0;
--		rdev_set_qos_map(rdev, dev, NULL);
-+
-+		if (!cfg80211_beaconing_iface_active(wdev)) {
-+			wdev->conn_owner_nlportid = 0;
-+			wdev->u.ap.ssid_len = 0;
-+			rdev_set_qos_map(rdev, dev, NULL);
-+		}
- 		if (notify)
- 			nl80211_send_ap_stopped(wdev, link_id);
- 
diff --git a/package/kernel/mac80211/patches/subsys/411-wifi-mac80211-keep-the-carrier-while-another-AP-link-beacons.patch b/package/kernel/mac80211/patches/subsys/411-wifi-mac80211-keep-the-carrier-while-another-AP-link-beacons.patch
