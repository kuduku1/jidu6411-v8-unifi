--	if (memcmp(fips_test_aes_cmac_value, mac, sizeof(mac)) != 0)
--		panic("aes: CMAC FIPS self-test failed (wrong MAC)\n");
--	memzero_explicit(&key, sizeof(key));
--}
--#else /* CONFIG_CRYPTO_LIB_AES_CBC_MACS */
