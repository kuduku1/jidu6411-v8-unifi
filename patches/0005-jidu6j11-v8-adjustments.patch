diff --git a/package/kernel/mac80211/patches/subsys/419-wifi-mac80211_hwsim-report-the-TX-counters-and-rate-of-each-station-link.patch b/package/kernel/mac80211/patches/subsys/419-wifi-mac80211_hwsim-report-the-TX-counters-and-rate-of-each-station-link.patch
