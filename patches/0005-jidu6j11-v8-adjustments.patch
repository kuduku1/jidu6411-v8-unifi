-+					       channel->band);
-+
- 	/* wmediumd mode check */
- 	_portid = READ_ONCE(data->wmediumd);
- 
-@@ -3030,6 +3071,7 @@ static int mac80211_hwsim_sta_add(struct
- 		     sta->valid_links);
- 		sp->active_links_rx = sta->valid_links;
- 	}
-+	sp->link_tx_valid = sta->valid_links;
- 
- 	spin_lock_init(&sp->nan_sched.lock);
- 
-@@ -3740,15 +3782,59 @@ static int mac80211_hwsim_change_sta_lin
- 					   u16 old_links, u16 new_links)
- {
- 	struct hwsim_sta_priv *sp = (void *)sta->drv_priv;
-+	unsigned long added = sta->valid_links & ~sp->link_tx_valid;
-+	unsigned int link_id;
- 
- 	hwsim_check_sta_magic(sta);
- 
- 	if (vif->type == NL80211_IFTYPE_STATION)
- 		sp->active_links_rx = new_links;
- 
-+	/* old_links and new_links hold active links only */
-+	for_each_set_bit(link_id, &added, IEEE80211_MLD_MAX_NUM_LINKS)
