@@ -1,81 +0,0 @@
-From: Felix Fietkau <nbd@nbd.name>
-Date: Thu, 8 Oct 2026 12:00:00 +0200
-Subject: [PATCH] wifi: mac80211: find the sender of a data frame by its link
- address
-
-__ieee80211_rx_handle_packet() looks up the sender of a data frame by
-addr2 in the station hash, which holds the MLD address of an MLO
-station. When a driver neither passes the station nor translates the
-addresses, a data frame of an MLO station carries a link address in
-addr2 and the lookup fails. The frame then goes through the
-per-interface loop, which skips AP_VLAN interfaces. For an MLO station
-that hostapd moved to an AP_VLAN, ieee80211_rx_h_data() thus drops
-every 4-address data frame on the AP interface as unexpected.
-
-If the station hash has no match, look up the sender in the link
-station hash and hand the frame to the interface of that station, as
-the station hash path does. Data frames of an MLO station then no
-longer go through the per-interface loop.
-
-Upstream fixed this as part of commit 6d531b9af16e ("wifi: mac80211:
-rework RX packet handling"), which depends on a change of the driver RX
-API.
-
-Signed-off-by: Felix Fietkau <nbd@nbd.name>
----
---- a/net/mac80211/rx.c
-+++ b/net/mac80211/rx.c
-@@ -5362,6 +5362,17 @@ static bool ieee80211_rx_for_interface(s
- 	return ieee80211_prepare_and_rx_handle(rx, skb, consume);
- }
- 
-+static bool ieee80211_rx_for_link_sta(struct ieee80211_rx_data *rx,
-+				      struct link_sta_info *link_sta,
-+				      struct sk_buff *skb, bool consume)
-+{
-+	rx->sdata = link_sta->sta->sdata;
-+	if (!ieee80211_rx_data_set_sta(rx, link_sta->sta, link_sta->link_id))
-+		return false;
-+
-+	return ieee80211_prepare_and_rx_handle(rx, skb, consume);
-+}
-+
- /*
-  * This is the actual Rx frames handler. as it belongs to Rx path it must
-  * be called with rcu_read_lock protection.
-@@ -5427,6 +5438,7 @@ static void __ieee80211_rx_handle_packet
- 		ieee80211_scan_rx(local, skb);
- 
- 	if (ieee80211_is_data(fc)) {
-+		struct link_sta_info *link_sta, *prev_link_sta;
- 		struct sta_info *sta, *prev_sta;
- 		int link_id = -1;
- 
-@@ -5512,6 +5524,27 @@ static void __ieee80211_rx_handle_packet
- 				return;
- 			goto out;
- 		}
-+
-+		prev_link_sta = NULL;
-+
-+		for_each_link_sta_info(local, hdr->addr2, link_sta, tmp) {
-+			if (!prev_link_sta) {
-+				prev_link_sta = link_sta;
-+				continue;
-+			}
-+
-+			ieee80211_rx_for_link_sta(&rx, prev_link_sta, skb,
-+						  false);
-+
-+			prev_link_sta = link_sta;
-+		}
-+
-+		if (prev_link_sta) {
-+			if (ieee80211_rx_for_link_sta(&rx, prev_link_sta, skb,
-+						      true))
-+				return;
-+			goto out;
-+		}
- 	}
- 
- 	prev = NULL;
diff --git a/package/kernel/mac80211/patches/subsys/404-wifi-mac80211_hwsim-keep-radar-detection-on-a-multi-radio.patch b/package/kernel/mac80211/patches/subsys/404-wifi-mac80211_hwsim-keep-radar-detection-on-a-multi-radio.patch
deleted file mode 100644
index 38407109..00000000
--- a/package/kernel/mac80211/patches/subsys/404-wifi-mac80211_hwsim-keep-radar-detection-on-a-multi-radio.patch
+++ /dev/null
@@ -1,44 +0,0 @@
-From: Felix Fietkau <nbd@nbd.name>
-Date: Sat, 26 Sep 2026 22:00:00 +0200
-Subject: [PATCH] wifi: mac80211_hwsim: keep radar detection on a multi-radio wiphy
-
-A radio that uses channel contexts gets no radar detection widths in its
-global interface combination, because DFS requires a combination with a
-single channel. A multi-radio radio always uses channel contexts, and
-its global combination multiplies the channel count by the number of
-radios. So it loses the radar detection widths as well, while each
-per-radio combination keeps them.
-
-mac80211 checks the channel of a radar detection against the global
-combination (ieee80211_check_combinations() with radio_idx -1 from
-_ieee80211_link_use_channel()). No combination matches, and every CAC on
-a multi-radio hwsim radio fails. hostapd reports it as "start_dfs_cac()
-failed" and disables the interface.
-
-cfg80211 exempts the global combination of a multi-radio wiphy from the
-single channel rule for DFS (wiphy_verify_iface_combinations()), since
-it only sums up the radios. Keep the radar detection widths there when
-each radio has one channel. With more than one channel per radio, clear
-them in the per-radio combination too, which cfg80211 would refuse
-otherwise.
-
-Signed-off-by: Felix Fietkau <nbd@nbd.name>
----
---- a/drivers/net/wireless/virtual/mac80211_hwsim_main.c
-+++ b/drivers/net/wireless/virtual/mac80211_hwsim_main.c
-@@ -6099,8 +6099,14 @@ static int mac80211_hwsim_new_radio(stru
- 		data->if_combination.num_different_channels *= n_bands;
- 	}
- 
--	if (data->use_chanctx)
-+	/*
-+	 * DFS needs a single channel per combination. cfg80211 exempts the
-+	 * global combination of a multi-radio wiphy.
-+	 */
-+	if (data->use_chanctx && (!param->multi_radio || data->channels > 1)) {
- 		data->if_combination.radar_detect_widths = 0;
-+		data->if_combination_radio.radar_detect_widths = 0;
-+	}
- 
- 	/* By default all radios belong to the first group */
- 	data->group = 1;
diff --git a/package/kernel/mac80211/patches/subsys/405-wifi-mac80211-report-the-combination-error-when-NAN-e.patch b/package/kernel/mac80211/patches/subsys/405-wifi-mac80211-report-the-combination-error-when-NAN-e.patch
