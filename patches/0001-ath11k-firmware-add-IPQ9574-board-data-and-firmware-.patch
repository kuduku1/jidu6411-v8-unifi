From 538b505ff2cfc1fd5b755a816eea3e946684efc3 Mon Sep 17 00:00:00 2001
From: Sandeep Sondagar <sandeepsondagar@gmail.com>
Date: Fri, 7 Aug 2026 12:54:21 +0530
Subject: [PATCH 1/5] ath11k-firmware: add IPQ9574 board data and firmware
 package

Add an IPQ9574 firmware package covering both the runtime firmware and
the board data, neither of which is yet present in the linux-firmware
distribution.

The firmware blobs come from the quic/upstream-wifi-fw legacy release
(snapshot d1491a6b, 2024-06-19) that also supplies the IPQ5018/QCN6122
firmware, while board-2.bin is fetched from the codelinaro
ath11k-firmware repo at a newer revision (2044a5b7, 2026-03-24) than the
shared source version. IPQ9574 board data was added to that repo only
after the shared revision, so it is sourced separately rather than
bumping the shared source, which would also change the IPQ6018 firmware
shipped by the other packages. Bump PKG_RELEASE.

The legacy revision bump from 795809c7 to d1491a6b is safe: the
IPQ5018/QCN6122 firmware tree object is byte-identical at both
revisions, so the ipq5018-qcn6122 package keeps shipping the same blobs;
only the tarball name and PKG_RELEASE change.

Signed-off-by: Sandeep Sondagar <sandeepsondagar@gmail.com>
(cherry picked from commit d40ac989d85a6ff29bafb02498031571984affa9)
---
 package/firmware/ath11k-firmware/Makefile | 53 ++++++++++++++++++++---
 1 file changed, 47 insertions(+), 6 deletions(-)

diff --git a/package/firmware/ath11k-firmware/Makefile b/package/firmware/ath11k-firmware/Makefile
index 18d7bac0..b4d2a043 100644
--- a/package/firmware/ath11k-firmware/Makefile
+++ b/package/firmware/ath11k-firmware/Makefile
@@ -11,7 +11,7 @@ PKG_NAME:=ath11k-firmware
 PKG_SOURCE_DATE:=2024-10-14
 PKG_SOURCE_VERSION:=15f050122da5ef5bef2cc8c7c19dfb7f98060a49
 PKG_MIRROR_HASH:=e7a89d1570f32552ade539376181494724b5eafb31d00451ff2dcf5a2922a0cb
-PKG_RELEASE:=1
+PKG_RELEASE:=2
 
 PKG_SOURCE_PROTO:=git
 PKG_SOURCE_URL:=https://git.codelinaro.org/clo/ath-firmware/ath11k-firmware.git
@@ -26,8 +26,8 @@ RSTRIP:=:
 STRIP:=:
 
 ATH11K_LEGACY_FW_NAME:=ath11k-legacy-firmware
-ATH11K_LEGACY_FW_DATE:=2024-03-14
-ATH11K_LEGACY_FW_RELEASE:=795809c7
+ATH11K_LEGACY_FW_DATE:=2024-06-19
+ATH11K_LEGACY_FW_RELEASE:=d1491a6b
 ATH11K_LEGACY_FW_SUBDIR:=$(ATH11K_LEGACY_FW_NAME)-$(ATH11K_LEGACY_FW_DATE)~$(ATH11K_LEGACY_FW_RELEASE)
 ATH11K_LEGACY_FW_SOURCE=$(ATH11K_LEGACY_FW_SUBDIR).tar.zst
 
@@ -35,12 +35,35 @@ define Download/$(ATH11K_LEGACY_FW_NAME)
 	FILE:=$(ATH11K_LEGACY_FW_SOURCE)
 	PROTO:=git
 	URL:=https://github.com/quic/upstream-wifi-fw.git
-	SOURCE_VERSION:=795809c7041582bd51bdfaa1f548b916ae8d4382
-	MIRROR_HASH:=b55bf7204543c7ba87876e84788239b0e47ad62434c5b0d1169526cde36a9daa
+	SOURCE_VERSION:=d1491a6b3b22bd6d755bb71ca06aec4246127726
+	MIRROR_HASH:=8882fbb4bf492086c4c9391eb5011e1cccc1acc7c047fd7f83f4c0389e36650d
 	SUBDIR:=$(ATH11K_LEGACY_FW_SUBDIR)
 endef
 $(eval $(call Download,$(ATH11K_LEGACY_FW_NAME)))
 
+# IPQ9574 is not yet present in the linux-firmware distribution. Its runtime
+# firmware blobs (m3_fw/q6_fw) ship only in the quic upstream-wifi-fw legacy
+# release, while board-2.bin was added to the codelinaro ath11k-firmware repo
+# only in a revision newer than the shared PKG_SOURCE_VERSION used by the
+# other packages. Fetch board-2.bin from the source that carries it instead
+# of bumping the shared PKG_SOURCE_VERSION, which would also change the
+# IPQ6018 firmware shipped by the other packages.
+ATH11K_IPQ9574_FW_NAME:=ath11k-firmware-ipq9574-board
+ATH11K_IPQ9574_FW_DATE:=2026-03-24
+ATH11K_IPQ9574_FW_RELEASE:=2044a5b7
+ATH11K_IPQ9574_FW_SUBDIR:=$(ATH11K_IPQ9574_FW_NAME)-$(ATH11K_IPQ9574_FW_DATE)~$(ATH11K_IPQ9574_FW_RELEASE)
+ATH11K_IPQ9574_FW_SOURCE=$(ATH11K_IPQ9574_FW_SUBDIR).tar.zst
+
+define Download/$(ATH11K_IPQ9574_FW_NAME)
+	FILE:=$(ATH11K_IPQ9574_FW_SOURCE)
+	PROTO:=git
+	URL:=$(PKG_SOURCE_URL)
+	SOURCE_VERSION:=2044a5b7e0da88a34c728a62e7f262b67c141739
+	MIRROR_HASH:=24b32f8ed38b640f40bac2860dd742dd5e5f3dc8bf7e655a7a41bdcbd94b1423
+	SUBDIR:=$(ATH11K_IPQ9574_FW_SUBDIR)
+endef
+$(eval $(call Download,$(ATH11K_IPQ9574_FW_NAME)))
+
 define Package/ath11k-firmware-default
   SECTION:=firmware
   CATEGORY:=Firmware
@@ -58,17 +81,24 @@ $(Package/ath11k-firmware-default)
   TITLE:=IPQ6018 ath11k firmware
 endef
 
+define Package/ath11k-firmware-ipq9574
+$(Package/ath11k-firmware-default)
+  TITLE:=IPQ9574 ath11k firmware
+endef
+
 define Build/Clean
 	$(call Build/Clean/Default,)
 
 	rm -rf \
-		$(BUILD_DIR)/$(ATH11K_LEGACY_FW_SUBDIR)
+		$(BUILD_DIR)/$(ATH11K_LEGACY_FW_SUBDIR) \
+		$(BUILD_DIR)/$(ATH11K_IPQ9574_FW_SUBDIR)
 endef
 
 define Build/Prepare
 	$(call Build/Prepare/Default,)
 
 	$(TAR) -C $(BUILD_DIR) -xf $(DL_DIR)/$(ATH11K_LEGACY_FW_SOURCE)
+	$(TAR) -C $(BUILD_DIR) -xf $(DL_DIR)/$(ATH11K_IPQ9574_FW_SOURCE)
 endef
 
 define Build/Compile
@@ -93,5 +123,16 @@ define Package/ath11k-firmware-ipq6018/install
 		$(1)/lib/firmware/IPQ6018/
 endef
 
+define Package/ath11k-firmware-ipq9574/install
+	$(INSTALL_DIR) $(1)/lib/firmware/ath11k/IPQ9574/hw1.0
+	$(INSTALL_DATA) \
+		$(BUILD_DIR)/$(ATH11K_LEGACY_FW_SUBDIR)/ath11k-firmware/IPQ9574/hw1.0/2.11.0.1.1/WLAN.HK.2.11.0.1.1-00039-QCAHKSWPL_SILICONZ-1/*.* \
+		$(1)/lib/firmware/ath11k/IPQ9574/hw1.0/
+	$(INSTALL_DATA) \
+		$(BUILD_DIR)/$(ATH11K_IPQ9574_FW_SUBDIR)/IPQ9574/hw1.0/board-2.bin \
+		$(1)/lib/firmware/ath11k/IPQ9574/hw1.0/
+endef
+
 $(eval $(call BuildPackage,ath11k-firmware-ipq5018-qcn6122))
 $(eval $(call BuildPackage,ath11k-firmware-ipq6018))
+$(eval $(call BuildPackage,ath11k-firmware-ipq9574))
-- 
2.43.0

