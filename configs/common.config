# ---- target: JioRouter AX6000 JIDU6J11, SKU 6411 (+6111, same board) ----
CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq95xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommbe_ipq95xx_DEVICE_jiorouter_ax6000-jidu6j11-6411=y
CONFIG_TARGET_DEVICE_qualcommbe_ipq95xx_DEVICE_jiorouter_ax6000-jidu6j11-6111=y
# drop wpad-basic from the per-device package list (full wpad-mbedtls below)
CONFIG_TARGET_DEVICE_PACKAGES_qualcommbe_ipq95xx_DEVICE_jiorouter_ax6000-jidu6j11-6411="-wpad-basic-mbedtls"
CONFIG_TARGET_DEVICE_PACKAGES_qualcommbe_ipq95xx_DEVICE_jiorouter_ax6000-jidu6j11-6111="-wpad-basic-mbedtls"
# ---- web UI over HTTPS (uhttpd TLS + certificate generator) ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
# ---- kernel modules that must match this kernel (cannot come from the feed later) ----
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-sched-act-police=y
CONFIG_PACKAGE_kmod-tun=y
# ---- Tailscale VPN integrated into the ROM ----
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_ca-bundle=y
# ---- tools ----
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_zram-swap=y
# full wpad (802.11k/v/r, SAE/WPA3) instead of wpad-basic
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-mbedtls=y
