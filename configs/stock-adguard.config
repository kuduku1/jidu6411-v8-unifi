# Stock OpenWrt router image with Tailscale and AdGuard Home (requires USB SSD)
CONFIG_PACKAGE_adguardhome=y

# USB Storage & Disk Drivers (USB 2.0/3.0 pendrives and USB SSDs with UAS)
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# Block Mount & LuCI Mount Points (System > Mount Points)
CONFIG_PACKAGE_block-mount=y

# Native Filesystem Drivers (ext4 for persistent AdGuard; FAT, exFAT, NTFS for file storage)
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_ntfs-3g=y

# Character sets for FAT and NTFS
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# Disk Partitioning, ext4 formatting, and diagnostics
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_usbutils=y

# Android & USB Phone Tethering Drivers
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_usb-modeswitch=y

# Multi-WAN (Failover Only & Load Balancing with Active ISP Health Watchdog)
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y

# LED Trigger Modules (for hardware/kernel timer blinking)
CONFIG_PACKAGE_kmod-ledtrig-timer=y

# Samba 4 File Sharing / NAS for USB SSD & Pendrives
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y

# Hardware & Software Flow Offloading (Full line-rate routing at 0% CPU)
CONFIG_PACKAGE_kmod-nft-offload=y

# Smart Queue Management (Cake SQM / Anti-Bufferbloat for Tethering & Gaming)
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_kmod-sched-cake=y

# iptables-nft translation layer (Prevents Tailscale from hanging looking for iptables/ip6tables)
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
