#!/bin/sh /etc/rc.common
# One-shot: installs openUF's runtime and finishes setup on the first boot
# with internet. Disables itself when done. See /usr/sbin/openuf-firstboot.

START=99
USE_PROCD=1

start_service() {
	[ -f /etc/openuf-firstboot.done ] && return 0
	procd_open_instance
	procd_set_param command /usr/sbin/openuf-firstboot
	procd_close_instance
}
