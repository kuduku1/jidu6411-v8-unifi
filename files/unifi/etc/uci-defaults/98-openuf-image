#!/bin/sh
# JIDU6J11 v8 (UniFi variant): openUF glue that has to run once.
grep -qx /opt/openuf/hook/adopt-shell.sh /etc/shells 2>/dev/null \
	|| echo /opt/openuf/hook/adopt-shell.sh >> /etc/shells

# Enable openUF service directly
[ -x /etc/init.d/openuf ] && /etc/init.d/openuf enable

# Keep openUF's state and the Tailscale login across sysupgrade.
for p in /opt/openuf/ /etc/openuf/ /etc/tailscale/; do
	grep -qx "$p" /etc/sysupgrade.conf || echo "$p" >> /etc/sysupgrade.conf
done
exit 0
