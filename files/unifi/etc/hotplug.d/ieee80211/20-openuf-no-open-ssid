#!/bin/sh
# openUF image: never let a stock OPEN SSID ("OpenWrt", encryption none) go on
# the air. This AP bridges straight into the management LAN, so an open SSID is
# an open door into it. Runs after 10-wifi-detect's `wifi config` each time a
# radio appears. SSIDs openUF writes (openuf_*) are never touched, and nothing
# that has encryption is touched either.
[ "${ACTION}" = "add" ] || exit 0
changed=0
for s in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-iface$/\1/p"); do
	case "$s" in openuf_*) continue ;; esac
	[ "$(uci -q get "wireless.$s.encryption")" = none ] || continue
	[ "$(uci -q get "wireless.$s.disabled")" = 1 ] && continue
	uci -q set "wireless.$s.disabled=1"
	changed=1
done
if [ "$changed" = 1 ]; then
	uci commit wireless
	logger -t openuf-image "disabled open default SSID(s) on a newly detected radio"
	ubus call network reload >/dev/null 2>&1
fi
exit 0
