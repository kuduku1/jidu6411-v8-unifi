config samba
	option workgroup 'WORKGROUP'
	option description 'JioRouter AX6000 NAS'
	option interface 'lan'
	option allow_legacy_protocols 'yes'

config sambashare
	option name 'Storage'
	option path '/mnt'
	option read_only 'no'
	option guest_ok 'yes'
	option create_mask '0666'
	option dir_mask '0777'
