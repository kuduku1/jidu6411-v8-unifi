#!/bin/sh
# JioRouter AX6000 JIDU6J11 (Stock Router Common): firstboot provisioning
#  - Standalone Router mode (WAN on eth0/wan with NAT/firewall; LAN on br-lan with DHCP)
#  - Root admin password set to 'admin'
#  - Wireless: Country US, 5GHz HE160 (SSID 'ODU', open), 2.4GHz HE20 (SSID 'ODU 2', open)
#  - Tailscale Subnet Router & Exit Node firewall plumbing
#  - USB Tethering & Multi-WAN failover
#  - Samba 4 NAS & USB storage auto-mount

. /lib/functions.sh

# ── 1. Root password: 'admin' ──
echo -e "admin\nadmin" | passwd root 2>/dev/null || true
if command -v openssl >/dev/null 2>&1; then
	H=$(openssl passwd -6 admin 2>/dev/null)
	[ -n "$H" ] && sed -i "s|^root:[^:]*:|root:$H:|" /etc/shadow
fi

# ── 2. Timezone: Asia/Kolkata ──
uci -q set system.@system[0].zonename='Asia/Kolkata'
uci -q set system.@system[0].timezone='IST-5:30'
uci -q commit system

# ── 3. Wireless configuration ──
# 5 GHz: ODU (open, HE160)
# 2.4 GHz: ODU 2 (open, HE20)
for r in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
	uci -q delete "wireless.$r.disabled"
	uci -q set "wireless.$r.country=US"
	
	band=$(uci -q get "wireless.$r.band")
	htmode=$(uci -q get "wireless.$r.htmode")
	
	if [ "$band" = "5g" ] || [ "$band" = "6g" ] || echo "$htmode" | grep -qi "vht\|he80\|he160"; then
		uci -q set "wireless.$r.htmode=HE160"
		uci -q set "wireless.$r.channel=36"
		DEV_5G="$r"
	else
		uci -q set "wireless.$r.htmode=HE20"
		DEV_2G="$r"
	fi
done

# Clear existing default wifi-iface sections and configure explicit SSIDs
while uci -q delete wireless.@wifi-iface[0]; do :; done

if [ -n "$DEV_5G" ]; then
	uci add wireless wifi-iface >/dev/null
	uci set wireless.@wifi-iface[-1].device="$DEV_5G"
	uci set wireless.@wifi-iface[-1].network='lan'
	uci set wireless.@wifi-iface[-1].mode='ap'
	uci set wireless.@wifi-iface[-1].ssid='ODU'
	uci set wireless.@wifi-iface[-1].encryption='none'
fi

if [ -n "$DEV_2G" ]; then
	uci add wireless wifi-iface >/dev/null
	uci set wireless.@wifi-iface[-1].device="$DEV_2G"
	uci set wireless.@wifi-iface[-1].network='lan'
	uci set wireless.@wifi-iface[-1].mode='ap'
	uci set wireless.@wifi-iface[-1].ssid='ODU2'
	uci set wireless.@wifi-iface[-1].encryption='none'
fi

uci commit wireless

# ── 4. Static DHCP Leases ──
add_static_lease() {
	local name="$1"
	local mac="$2"
	local ip="$3"
	
	# Delete any existing lease for this IP or MAC to avoid duplicates
	for s in $(uci -q show dhcp | sed -n "s/^dhcp\.@host\[\([0-9]*\)\].*$/\1/p" | sort -ru); do
		cur_mac=$(uci -q get "dhcp.@host[$s].mac")
		cur_ip=$(uci -q get "dhcp.@host[$s].ip")
		if [ "$cur_mac" = "$mac" ] || [ "$cur_ip" = "$ip" ]; then
			uci -q delete "dhcp.@host[$s]"
		fi
	done
	
	uci add dhcp host >/dev/null
	uci set dhcp.@host[-1].name="$name"
	uci set dhcp.@host[-1].mac="$mac"
	uci set dhcp.@host[-1].ip="$ip"
}

add_static_lease "HP-VIJ" "AC:F4:66:C8:5A:AF" "192.168.1.100"
add_static_lease "Google-Home-Mini" "44:07:0B:D7:70:CB" "192.168.1.200"
add_static_lease "Galaxy-Tab-A11-5G" "56:6D:08:BC:57:24" "192.168.1.104"
add_static_lease "Vijay-s-S23U" "B4:0B:1D:08:B3:37" "192.168.1.102"
add_static_lease "HP-VIJ" "F0:68:E3:DD:00:2A" "192.168.1.101"

uci commit dhcp

# ── 4. Storage & Mount Points (fstab auto-mount for USB pendrives and SSDs) ──
uci -q set fstab.@global[0].anon_mount='1'
uci -q set fstab.@global[0].auto_mount='1'
uci -q commit fstab

# ── 5. USB Tethering & Multi-WAN (Failover Only & Load Balancing) ──
# Explicit metrics for mwan3 tracking
uci -q set network.wan.metric='10'

# Auto-configured Tether interface (usb0 / rndis)
uci -q set network.tether=interface
uci -q set network.tether.proto='dhcp'
uci -q set network.tether.device='usb0'
uci -q set network.tether.metric='20'
uci -q commit network

# Attach tether interface to WAN firewall zone
for z in $(uci -q show firewall | sed -n "s/^firewall\.@zone\[\([0-9]*\)\].name='wan'/\1/p"); do
	uci -q add_list "firewall.@zone[$z].network=tether"
done
uci -q commit firewall

chmod +x /usr/sbin/wan-mode 2>/dev/null || true
chmod +x /etc/hotplug.d/net/40-usb-tether 2>/dev/null || true

[ -x /etc/init.d/mwan3 ] && /etc/init.d/mwan3 enable

# ── 6. Network LED Watchdog ──
chmod +x /usr/sbin/network-led-watchdog 2>/dev/null || true
chmod +x /etc/init.d/network-led-watchdog 2>/dev/null || true
chmod +x /etc/hotplug.d/iface/99-network-led 2>/dev/null || true

[ -x /etc/init.d/network-led-watchdog ] && /etc/init.d/network-led-watchdog enable

# ── 7. Hardware & Software Flow Offloading (Full Line-Rate Throughput) ──
uci -q set firewall.@defaults[0].flow_offloading='1'
uci -q set firewall.@defaults[0].flow_offloading_hw='1'
uci -q commit firewall

# ── 8. Samba 4 (NAS File Sharing for USB Storage) ──
[ -x /etc/init.d/samba4 ] && /etc/init.d/samba4 enable

# ── 9. uHTTPd Anti-Hang Fix (Zero Keepalive Stalls for Instant LuCI Loading) ──
uci -q set uhttpd.main.http_keepalive='0'
uci -q commit uhttpd

exit 0
