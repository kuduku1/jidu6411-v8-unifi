#!/bin/sh /etc/rc.common

USE_PROCD=1
START=21
STOP=89

PROG=/usr/bin/AdGuardHome

start_service() {
	[ -x "$PROG" ] || return 1

	# Ensure configuration exists
	if [ ! -f /etc/adguardhome/adguardhome.yaml ] && [ -f /etc/adguardhome.yaml ]; then
		mkdir -p /etc/adguardhome
		cp -a /etc/adguardhome.yaml /etc/adguardhome/adguardhome.yaml
	fi

	# Dynamic storage selection: Ext4 SSD vs RAM tmpfs
	if [ -x /usr/sbin/adguardhome-storage-select ]; then
		/usr/sbin/adguardhome-storage-select
	fi

	procd_open_instance
	procd_set_param command "$PROG" -c /etc/adguardhome/adguardhome.yaml -w /var/lib/adguardhome --no-check-update
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1

	if id -u adguardhome >/dev/null 2>&1; then
		procd_set_param user adguardhome
		procd_set_param group adguardhome
	fi

	procd_close_instance
}

stop_service() {
	# Procd handles process termination cleanly
	:
}

service_triggers() {
	procd_add_reload_trigger "adguardhome"
}
